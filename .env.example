# Discord
DISCORD_TOKEN=replace_with_new_discord_bot_token
PORT=10000

# Lavalink (same Docker container)
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=replace_with_a_long_random_password
LAVALINK_SECURE=false

# Music provider credentials (optional; keep private)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
APPLE_MUSIC_ENABLED=false
APPLE_MUSIC_API_TOKEN=
DEEZER_ENABLED=false
DEEZER_MASTER_KEY=
DEEZER_ARL=

# JSON persistence directory (mount a persistent disk here on Render)
DATA_DIR=/app/data
