# Required to start BauaaCore
DISCORD_TOKEN=replace_with_discord_bot_token
MONGODB_URI=mongodb://localhost:27017/bauaacore

# HTTP port. Render sets PORT for its web service.
PORT=10000

# Optional. Set to music on your PC when a hosted instance handles general commands.
BAUAA_INSTANCE_ROLE=
# Optional ANSI colors in Render logs. Status emoji appear by default.
BAUAA_RENDER_COLOR=0

# Required for AI replies
GROQ_API_KEY=

# Optional Groq model settings. Leave the fallback value empty to turn it off.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b

# Optional. Set to Bauaa's Discord user ID for tag recognition and /ai-instructions.
BOT_OWNER_ID=

# Music uses a self-hosted Lavalink 4.2+ node. Use the same password for the bot and the node.
LAVALINK_URL=http://127.0.0.1:2333
LAVALINK_PASSWORD=
# Optional backup and additional trusted direct-media hosts (comma-separated)
LAVALINK_URL_BACKUP=
LAVALINK_PASSWORD_BACKUP=
MUSIC_MEDIA_HOSTS=
# Optional path to yt-dlp on the bot host. For YouTube, use the same internet connection as Lavalink.
MUSIC_YTDLP_PATH=
# Bot HTTP origin reachable from Lavalink for converted uploads, direct media, and provider fallbacks.
MUSIC_MEDIA_BASE_URL=

# Optional account integrations. Generate a separate, long random MUSIC_ACCOUNT_SECRET.
MUSIC_ACCOUNT_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=
LASTFM_API_KEY=
LASTFM_API_SECRET=



